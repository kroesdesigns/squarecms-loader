{
  "name": "squarecms-loader",
  "version": "1.0.0",
  "description": "SquareCMS runtime loader for Squarespace sites — swaps {{tags}} for CMS values.",
  "private": true,
  "scripts": {
    "build": "terser os-cms-loader.js --compress --mangle --comments '/osCMS loader/' -o os-cms-loader.min.js",
    "check": "node --check os-cms-loader.js"
  },
  "devDependencies": {
    "terser": "^5.36.0"
  }
}
